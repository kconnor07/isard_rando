<% if (it.content.badge) { %><div class="badge"><%= it.content.badge %></div><% } %>
<h2 class="title"><%~ it.titleHtml %></h2>
<% if (it.content.body) { %><p class="body" style="align-self:center"><%= it.content.body %></p><% } %>
<% if (it.keyword) { %>
<div style="display:flex;flex-direction:column;align-items:center;gap:28px;margin-top:20px">
  <div class="keyword-chip">💬 Commente « <%= it.keyword %> »</div>
  <p class="body" style="font-size:33px;opacity:0.85">et reçois le lien direct en message privé</p>
</div>
<% } else if (it.content.ctaLabel) { %>
<div class="cta-button" style="margin-top:20px"><%= it.content.ctaLabel %></div>
<% } %>
<div class="scribble" style="margin-top:14px">
  <svg viewBox="0 0 300 24" preserveAspectRatio="none">
    <path d="M4 14 C 60 4, 120 20, 170 10 S 270 14, 296 8" />
    <path d="M30 20 C 90 12, 180 22, 260 15" opacity="0.55" />
  </svg>
</div>
