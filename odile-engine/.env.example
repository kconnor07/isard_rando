# ============================================================================
# Odile Engine — configuration (.env)
# Copie ce fichier en `.env` et remplis les valeurs. AUCUNE de ces valeurs
# ne doit être commitée ni exposée côté client.
# ============================================================================

# ----- Général ---------------------------------------------------------------
NODE_ENV=production
PORT=3080
# URL publique HTTPS du serveur (webhooks Meta, images publiques, liens email).
# En production : https://engine.odileai.com — en dev local : http://localhost:3080
PUBLIC_URL=https://engine.odileai.com
# Domaine servi par Caddy (docker-compose production)
DOMAIN=engine.odileai.com
# Secret maître (signatures HMAC des liens + chiffrement des jetons OAuth).
# Génère-le avec : openssl rand -base64 32
APP_SECRET=change-me-openssl-rand-base64-32
# Mot de passe du dashboard
ADMIN_PASSWORD=change-me

# ----- IA --------------------------------------------------------------------
# live = vrais appels ; mock = réponses simulées (tests sans clé)
LLM_MODE=live
# Clé Anthropic (rédaction + passe finale du studio de design) — console.anthropic.com
ANTHROPIC_API_KEY=
# Clé Google AI Studio (scoring de masse + vision, économique) — aistudio.google.com
GEMINI_API_KEY=
# Modèles (défauts recommandés)
ANTHROPIC_MODEL_WRITER=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
GEMINI_MODEL_SCORING=gemini-2.5-flash-lite
GEMINI_MODEL_VISION=gemini-2.5-flash

# ----- Publication -----------------------------------------------------------
# dry = simulation (payloads écrits dans var/outbox, aucun appel aux réseaux)
# live = publication réelle — ne passer en live qu'après les tests !
PUBLISH_MODE=dry

# ----- Email (validation des posts) -----------------------------------------
# Recommandé : Brevo (300 emails/j gratuits) ou Resend. Voir docs/setup-smtp.md
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Odile Engine <engine@odileai.com>"
# Destinataire des validations (modifiable ensuite dans le dashboard)
APPROVAL_EMAIL_TO=

# ----- LinkedIn (docs/setup-linkedin.md) -------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ----- Meta / Instagram (docs/setup-meta.md) ---------------------------------
META_APP_ID=
META_APP_SECRET=
# Valeur libre, à recopier telle quelle dans la config du webhook Meta
META_VERIFY_TOKEN=odile-webhook-2026

# ----- Avancé ----------------------------------------------------------------
# Chemin explicite de Chromium (auto-détecté sinon ; /usr/bin/chromium en Docker)
#CHROMIUM_PATH=
# Désactiver les crons (débogage)
#DISABLE_SCHEDULER=1
